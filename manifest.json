{
  "manifest_version": 3,
  "name": "Insight Extractor helper",
  "version": "1.0.0",
  "description": "Lets Insight Extractor on jaskaransethy.com read a product's Amazon or Flipkart reviews, fetched from your own browser.",
  "homepage_url": "https://github.com/jaskaran-sethy/insight-extractor-extension",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://jaskaransethy.com/*", "https://www.jaskaransethy.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://www.amazon.com/*",
    "https://www.flipkart.com/*"
  ],
  "action": {
    "default_title": "Open Insight Extractor",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
